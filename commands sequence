cd /mnt/agents/output/adtech_prototype

cat > .gitignore <<'EOF'
# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.env
.venv/
venv/

# Jupyter
.ipynb_checkpoints/

# Data
*.csv
*.parquet
data/

# Models (keep ONNX, ignore large checkpoints)
*.pt
*.pth
*.ckckpt
*.onnx

# OS
.DS_Store
Thumbs.db
EOF

mkdir -p .github/workflows

cat > .github/workflows/ci.yml <<'EOF'
name: CI

on:
  push:
    branches: [ main, master ]
  pull_request:
    branches: [ main, master ]

jobs:
  test:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'

      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install -r requirements.txt

      - name: Lint with flake8
        run: |
          pip install flake8
          flake8 src || true

      - name: Validate Python syntax
        run: |
          python -m compileall src

      - name: Smoke test
        run: |
          python - <<'PY'
          print('CI smoke test passed')
          PY
EOF

git init
git branch -M main
git add .
git commit -m "feat: add repo scaffolding and CI"
git remote add origin https://github.com/Lineage88/lineage-adtech-triton.git
git push -u origin main